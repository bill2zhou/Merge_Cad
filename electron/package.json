{
  "name": "merge-cad-electron",
  "version": "1.0.2",
  "productName": "GenCAD文件合并工具",
  "description": "GenCAD 文件合并工具（Electron 版）",
  "main": "main.js",
  "author": "GenCAD",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gencad.merge",
    "productName": "GenCAD文件合并工具",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GenCAD文件合并工具"
    }
  }
}
